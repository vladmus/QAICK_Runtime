{
  "name": "@qaick/runtime",
  "version": "0.2.1",
  "description": "Host-neutral composition layer for QAick execution.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladmus/QAICK_Runtime.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@qaick/executor": "0.2.1"
  },
  "devDependencies": {
    "@qaick/http-executor": "0.2.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
